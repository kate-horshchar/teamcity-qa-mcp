# TeamCity MCP Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# TeamCity server URL
TEAMCITY_URL=https://your-teamcity-instance.com

# Your personal TeamCity API token (Bearer)
# Generate at: https://<your-teamcity>/profile.html?item=accessTokens
TEAMCITY_TOKEN=

# Build configuration ID to monitor
TEAMCITY_BUILD_TYPE_ID=YourProject_YourBuildConfig

# Optional settings (defaults shown)
TEAMCITY_DEFAULT_LOOKBACK_BUILDS=20
TEAMCITY_LOG_TAIL_LINES=200
TEAMCITY_SIMILAR_FAILURES_LIMIT=10
